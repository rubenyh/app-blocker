<?xml version="1.0" encoding="utf-8"?>
<!--
   Backups are disabled. Settings are six local toggles that are cheap to set again, and
   diagnostics are never persisted, so nothing needs to leave the device.
   android:allowBackup="false" disables Auto Backup and, on Android 11 and lower, device
   transfer. On Android 12+ some manufacturers' devices still run device-to-device transfer
   when allowBackup="false", so these rules exclude every domain for both cloud backup and
   device transfer.
   See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
